# Any OpenAI-compatible chat API.
# OpenAI:  keep the base URL, set your key and a model.
# Ollama (free, local): OPENAI_BASE_URL=http://localhost:11434/v1, leave the key empty,
#                       OPENAI_MODEL=llama3.2 (or any model you have pulled).
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Optional: only set this if your model accepts a custom temperature.
# OPENAI_TEMPERATURE=0

# Protects your API budget on a public server: requests per minute per visitor.
RATE_LIMIT_PER_MINUTE=20
# Set to 1 when running behind nginx, Heroku or another proxy.
TRUST_PROXY=0
